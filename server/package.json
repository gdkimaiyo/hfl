{
  "name": "hfl-service",
  "version": "1.0.0",
  "description": "HFL backend service",
  "main": "index.js",
  "repository": "https://github.com/gdkimaiyo/hfl-service.git",
  "author": "Gideon Kimaiyo <gdkimaiyo@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist && mkdir dist",
    "serve": "DEBUG=log node dist/index.js",
    "build": "yarn clean && babel src -d dist -s --source-maps --copy-files",
    "start:dev": "cross-env NODE_ENV=development DEBUG=log nodemon",
    "start:debug": "NODE_ENV=development DEBUG=log nodemon --config nodemon-debug.json",
    "lint": "node_modules/.bin/eslint ./src",
    "lint:fix": "node_modules/.bin/eslint ./src --fix",
    "jest": "node node_modules/jest/bin/jest.js",
    "jest:debug": "node --inspect-brk -r node_modules/.bin/jest --runInBand",
    "test": "vitest run",
    "watch-test": "yarn test -- --watchAll"
  },
  "dependencies": {
    "@hapi/joi": "^17.1.1",
    "@hapi/joi-date": "^2.0.1",
    "axios": "^1.7.7",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "debug": "^4.3.7",
    "dotenv-extended": "^2.9.0",
    "esm": "^3.2.25",
    "express": "^4.21.1",
    "express-handlebars": "^8.0.1",
    "express-session": "^1.18.1",
    "fs-extra": "^11.2.0",
    "graceful-fs": "^4.2.11",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "lodash": "^4.17.21",
    "lru-cache": "^11.0.1",
    "mongoose": "^8.7.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "peer": "^1.0.2",
    "redis": "^4.7.0",
    "request-promise-native": "^1.0.9",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.7",
    "@babel/core": "^7.25.8",
    "@babel/node": "^7.25.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-classes": "^7.25.7",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.25.8",
    "@babel/register": "^7.25.7",
    "@types/node-fetch": "^2.6.11",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^29.7.0",
    "commitplease": "^3.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.12.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-staged": "^1.0.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "vitest": "^2.1.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "yarn eslint-staged ./src --fix"
    ]
  }
}
